{
  "name": "lab-tictactoe-web",
  "private": true,
  "version": "1.0.0",
  "description": "One-page frontend for the Noughts (NGHT) TicTacToeWager launch on Sepolia",
  "type": "module",
  "scripts": {
    "prepare:manifest": "node scripts/manifest.ts prepare",
    "dev": "npm run prepare:manifest && vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run prepare:manifest && npm run typecheck && vite build && node scripts/manifest.ts finalize",
    "verify:manifest": "node scripts/manifest.ts verify",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run test/lib.test.ts",
    "test:e2e": "node test/e2e/run.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
